{
  "name": "ilikepdf-auth-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Google sign-in, token ledger and payments for iLikePdf, on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ilikepdf",
    "db:migrate:local": "wrangler d1 execute ilikepdf --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute ilikepdf --remote --file=schema.sql",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
